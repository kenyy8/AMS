%% Flowchart for Meter-Enabled Smart ID Apartment Management System
%% Fixed version for Mermaid 10.9.4 compatibility

flowchart LR
  subgraph Frontend
    F1[React App - Property Manager & Tenant UIs]
    F2[Axios / API Client]
    F3[QR Scanner / Mobile]
  end

  subgraph Backend
    B1[Express Server - backend/server.js]
  B2[REST API endpoints: /api/tenants, /api/apartments, /api/bills, /api/meter-devices, /api/qr-codes]
    B3[Controllers & Services]
    B4[Scheduler / scripts - scripts/check_devices.js]
  end

  subgraph DB[MySQL Database]
    D1[apartments table]
    D2[tenants table]
    D3[bills table]
  D4[meter_devices table]
    D5[property_managers, payments, qr_codes...]
  end

  subgraph Meter[Meter Devices & Gateways]
    I1[Smart Meters / Devices]
  I2[Gateway Services - backend/services/meterGateway.js]
  end

  F1 -->|calls| F2
  F2 -->|HTTP| B1
  F3 -->|scans QR / POST QR| B1

  B1 -->|queries/inserts| DB
  B3 -->|updates| D3
  B1 -->|uses| B3
  B1 -->|uses scheduler| B4

  I1 -->|sends readings| I2
  I2 -->|forwards readings via API| B1
  B1 -->|stores device state| D4
  B1 -->|generates QR tokens| D5

  DB -->|referenced by| B3
