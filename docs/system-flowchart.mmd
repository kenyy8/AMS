%% System Flowchart - Smart Apartment Management System (clean layout)
flowchart LR

  %% External actors
  subgraph EXT [External Actors]
    direction TB
    PM["Property Manager\n(Admin UI)"]
    TEN["Tenant\n(Portal / Mobile)"]
    MTR["Meter Devices\n(IoT)"]
    PG["Payment Gateway\n(External)"]
  end

  %% Frontends
  subgraph FE [Frontend Apps]
    direction TB
    FE1["Admin Frontend\n(React)"]
    FE2["Tenant Frontend\n(React)"]
  end

  %% Backend modules grouped
  subgraph BE [Backend Services]
    direction TB
    API[["API Layer\n(Express)"]]
    AUTH(("Auth\nJWT / Middleware"))
    ROUTES["Routes & Controllers"]
    subgraph BE_SIDE [Processing]
      direction TB
      METER["Meter Service\n(device ingestion)"]
      BILLS["Billing Engine\n(bill calc & store)"]
      NOTIF["Notifications\nScheduler & Sender"]
    end
  end

  DB[("MySQL Database\n(tenants, apartments, bills, devices)")]

  %% Layout and flows
  PM -->|"uses"| FE1
  TEN -->|"uses / scans QR"| FE2

  FE1 -->|"REST / Socket"| API
  FE2 -->|"REST / QR"| API

  API -->|"authenticate"| AUTH
  API --> ROUTES
  ROUTES -->|"CRUD: tenants, apartments"| DB

  MTR -.->|"reads/send"| METER
  API -->|"device scan"| METER
  METER -->|"consumption events"| BILLS

  ROUTES -->|"create/read bills"| BILLS
  BILLS -->|"persist bills/payments"| DB
  BILLS -->|"request payment"| PG
  PG -->|"payment result"| BILLS

  BILLS -->|"notify"| NOTIF
  NOTIF -->|"email/sms/websocket"| FE1
  NOTIF -->|"email/sms/websocket"| FE2
  NOTIF -->|"read/write schedule"| DB

  %% Styling for a cleaner look
  classDef actor fill:#fff0d9,stroke:#d08a00,stroke-width:1px
  classDef frontend fill:#e6f7ff,stroke:#2b8cff,stroke-width:1px
  classDef backend fill:#f6fff2,stroke:#34a853,stroke-width:1px
  classDef db fill:#fff7f0,stroke:#c68a00,stroke-width:1px
  class EXT actor
  class FE frontend
  class BE backend
  class DB db

  %% Make arrows straight and spaced
  linkStyle default interpolate basis

%% End of flowchart
