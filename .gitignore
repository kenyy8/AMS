# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Keep package-lock.json files for reproducible npm installs.

# Build outputs
/build/
/dist/
/frontend/build/

# Logs
*.log
logs/
server_run.log
server_smoke.log
smoke_results.log
frontend.log
backend.log

# Environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Python
__pycache__/
*.py[cod]

# Generated/test artifacts
*_result.json
*_resp.json
bills_after_*.json

# Misc
/dist/
coverage/
.npm-cache/
/backend/data/
/demo-accounts.local*.csv
/render-demo-accounts.local*.csv

# Ignore frontend dependency folder if present
frontend/node_modules/

# Ignore backend node modules
backend/node_modules/

# Ignore compiled assets
# CRA requires frontend/public and its HTML template.
!/.vscode/
/.vscode/*
!/.vscode/settings.json

# Keep this file tracked
!/.gitignore
